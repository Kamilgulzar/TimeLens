{
  "manifest_version": 3,
  "name": "TimeLens",
  "version": "0.1.0",
  "description": "Time intelligence for the web. Quietly track where your time goes.",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "TimeLens"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "idle",
    "alarms",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://server-liart-xi-18.vercel.app/*"
  ],
  "minimum_chrome_version": "110"
}